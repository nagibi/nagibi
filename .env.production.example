# Copiar para /opt/nagibi/.env no servidor
# Fonte única: deploy-prod.sh copia este arquivo → projects/ibigan-api/.env
# Domínio: nagibi.com.br

# ═══════════════════════════════════════════════════════════════
# Docker Compose (projeto fixo: nagibi — não renomeie)
# ═══════════════════════════════════════════════════════════════
NGINX_BEHIND_PROXY=true
NGINX_HTTP_BIND=127.0.0.1
NGINX_HTTP_PORT=28080

MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=nagibi_central
MYSQL_USER=nagibi
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_ADMIN

# ═══════════════════════════════════════════════════════════════
# Laravel (APP)
# ═══════════════════════════════════════════════════════════════
APP_NAME="Nagibi"
APP_ENV=production
# Deixe vazio no primeiro deploy — deploy-prod.sh gera automaticamente
APP_KEY=
APP_DEBUG=false
APP_URL=https://nagibi.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

API_RATE_LIMIT_PER_MINUTE=600

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB_* — deploy preenche a partir de MYSQL_* se ausente
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nagibi_central
DB_USERNAME=nagibi
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=nagibi_

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ═══════════════════════════════════════════════════════════════
# Mail (Brevo)
# ═══════════════════════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_BREVO_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@nagibi.com.br
MAIL_FROM_NAME="${APP_NAME}"

EMAIL_BRAND_NAME=Nagibi
EMAIL_LOGO_URL=https://nagibi.com.br/images/email/nagibi-logo.png

# ═══════════════════════════════════════════════════════════════
# Reverb / WebSocket
# ═══════════════════════════════════════════════════════════════
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=366217
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_PUBLIC_HOST=nagibi.com.br
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# ═══════════════════════════════════════════════════════════════
# Frontend / multi-tenant
# ═══════════════════════════════════════════════════════════════
FRONTEND_URL=https://nagibi.com.br
CENTRAL_DOMAIN=nagibi.com.br
TENANT_DEV_DOMAIN_SUFFIXES=nagibi.com.br
TENANT_CONTEXT_QUERY_PARAM=tenant

# ═══════════════════════════════════════════════════════════════
# OAuth
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nagibi.com.br/api/v1/auth/google/callback

# Scout / Meilisearch — MEILISEARCH_KEY é a master key do container (openssl rand -hex 32)
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE_ME_MEILISEARCH_KEY

# ═══════════════════════════════════════════════════════════════
# Dev tools (painel central)
# ═══════════════════════════════════════════════════════════════
DEV_TOOLS_API_DOCS_URL=https://nagibi.com.br/docs/api
DEV_TOOLS_HORIZON_URL=https://nagibi.com.br/horizon
DEV_TOOLS_TELESCOPE_URL=https://nagibi.com.br/telescope
DEV_TOOLS_CLOCKWORK_URL=https://nagibi.com.br/clockwork
DEV_TOOLS_LOG_VIEWER_URL=https://nagibi.com.br/log-viewer

# ═══════════════════════════════════════════════════════════════
# Observabilidade
# ═══════════════════════════════════════════════════════════════
TELESCOPE_ENABLED=true
TELESCOPE_RECORD_ALL=true
CLOCKWORK_ENABLE=true
LOG_VIEWER_ENABLED=true

PROMETHEUS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

FILESYSTEM_DISK=local

# ═══════════════════════════════════════════════════════════════
# VITE_* NÃO ficam aqui — use no build do SPA (ibigan-web):
#   VITE_REVERB_APP_KEY=<mesmo REVERB_APP_KEY>
#   VITE_REVERB_HOST=nagibi.com.br
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
# ═══════════════════════════════════════════════════════════════
