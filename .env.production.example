# Copiar para /opt/nagibi/.env no servidor Vultr (216.238.124.52)
# Domínio: nagibi.com.br
#
# IMPORTANTE: defina MYSQL_USER/MYSQL_PASSWORD — DB_USERNAME/DB_PASSWORD são
# preenchidos automaticamente pelo deploy se estiverem ausentes.

APP_NAME=nagibi
APP_ENV=production
# Deixe vazio no primeiro deploy — deploy-prod.sh gera automaticamente
APP_KEY=
APP_DEBUG=false
APP_URL=https://nagibi.com.br
APP_TIMEZONE=America/Sao_Paulo

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nagibi_central
DB_USERNAME=nagibi
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=nagibi_

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_PUBLIC_HOST=nagibi.com.br
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@nagibi.com.br
MAIL_FROM_NAME=nagibi

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

FRONTEND_URL=https://nagibi.com.br

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: https://nagibi.com.br/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nagibi.com.br/api/v1/auth/google/callback

# Host central (login sem subdomínio, painel SaaS)
CENTRAL_DOMAIN=nagibi.com.br

# Subdomínios de tenant em produção: odontomax.nagibi.com.br → slug odontomax
# Requer DNS wildcard *.nagibi.com.br e certificado SSL wildcard.
TENANT_DEV_DOMAIN_SUFFIXES=nagibi.com.br
TENANT_CONTEXT_QUERY_PARAM=tenant

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Docker Compose (docker-compose.prod.yml)
# Portas locais para coexistir com /opt/ibigan no mesmo servidor
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8443
REVERB_HOST_PORT=8083
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=nagibi_central
MYSQL_USER=nagibi
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
