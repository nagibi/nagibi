VITE_APP_NAME=Ibigan
# Use /api (relativo) para subdomínios *.localhost; ou http://localhost/api com X-Forwarded-Host automático
VITE_API_URL=/api

# WebSocket — Reverb (porta exposta no host: 8082)
VITE_REVERB_APP_KEY=ibigan_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8082
VITE_REVERB_SCHEME=http

# Notificações — catálogo remoto (requer GET /v1/notification-events no backend)
# VITE_NOTIFICATION_EVENTS_API=true
# VITE_DEV_API_DOCS_URL=http://localhost/docs/api
# VITE_DEV_HORIZON_URL=http://localhost/horizon
# VITE_DEV_TELESCOPE_URL=http://localhost/telescope
# VITE_DEV_CLOCKWORK_URL=http://localhost/clockwork
# VITE_DEV_LOG_VIEWER_URL=http://localhost/log-viewer
# VITE_DEV_PHPMYADMIN_URL=http://localhost:8081
# VITE_DEV_MAILPIT_URL=http://localhost:8025
# VITE_DEV_MEILISEARCH_URL=http://localhost:7701
# Ao abrir o app por IP na LAN (ex.: 192.168.x.x), localhost nas URLs acima
# é reescrito automaticamente para o host do navegador.
# VITE_DEV_GRAFANA_URL=http://localhost:3001
# VITE_DEV_PROMETHEUS_URL=http://localhost:9091
# VITE_DEV_CADVISOR_URL=http://localhost:8086
# VITE_DEV_SENTRY_URL=https://us.sentry.io/issues/?project=4511587854188544

# Sentry (opcional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
